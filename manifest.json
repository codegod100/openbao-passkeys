{
  "manifest_version": 3,
  "name": "OpenBao Passkeys",
  "version": "0.2.3",
  "description": "Passkeys and passwords stored in OpenBao, with WebAuthn proxy and form autofill.",
  "minimum_chrome_version": "115",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webAuthenticationProxy",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "OpenBao Passkeys",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/autofill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
